# Normalize text files to LF in the repository and in the working tree.
* text=auto eol=lf

# Documentation sources
*.rst   text eol=lf
*.md    text eol=lf
*.txt   text eol=lf
*.css   text eol=lf
*.js    text eol=lf
*.json  text eol=lf
*.yaml  text eol=lf
*.yml   text eol=lf
*.py    text eol=lf
*.sh    text eol=lf
*.uml   text eol=lf

# Keep the Windows scripts with CRLF, they are usually edited on Windows
*.bat   text eol=crlf

# Binary files must never be converted
*.png   binary
*.jpg   binary
*.pdf   binary
*.drawio binary
